# ──────────────────────────────────────────────────────────────────────────────
# Microsoft 365 connector
# Found in: Azure portal → Entra ID → App registrations → your app
# ──────────────────────────────────────────────────────────────────────────────
M365_TENANT_ID=
M365_CLIENT_ID=
# Secret stored in Key Vault — do not paste real secret here.
# Use AZURE_KEYVAULT_URL + a secret named "m365-client-secret" in production.
M365_CLIENT_SECRET_REF=m365-client-secret

# ──────────────────────────────────────────────────────────────────────────────
# Azure connector
# DefaultAzureCredential is recommended (managed identity / az login)
# ──────────────────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Optional — leave blank to use az login / managed identity
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET_REF=azure-client-secret

# ──────────────────────────────────────────────────────────────────────────────
# Kubernetes connector
# ──────────────────────────────────────────────────────────────────────────────
# Path to kubeconfig file (leave blank to use in-cluster service account)
KUBECONFIG_PATH=

# ──────────────────────────────────────────────────────────────────────────────
# Microsoft Foundry connector
# Found in: AI Foundry portal → your project → Overview → "Project endpoint"
# ──────────────────────────────────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_PROJECT_NAME=

# ──────────────────────────────────────────────────────────────────────────────
# Microsoft Agent 365 connector
# Requires Graph permission: AgentRegistration.Read.All, Reports.Read.All
# Uses DefaultAzureCredential by default (az login / managed identity).
# For service principal auth, also set AGENT365_CLIENT_ID + AGENT365_CLIENT_SECRET.
# ──────────────────────────────────────────────────────────────────────────────
AGENT365_TENANT_ID=
AGENT365_CLIENT_ID=
AGENT365_CLIENT_SECRET_REF=agent365-client-secret
# Set to true to enable live Graph API calls for agent registrations + usage
CONTROL_PLANE_AGENT365_LIVE=false

# ──────────────────────────────────────────────────────────────────────────────
# ServiceNow connector
# ──────────────────────────────────────────────────────────────────────────────
SERVICENOW_BASE_URL=https://your-instance.service-now.com
SERVICENOW_API_KEY_REF=servicenow-api-key
# Or use OAuth:
# SERVICENOW_CLIENT_ID=
# SERVICENOW_CLIENT_SECRET_REF=servicenow-client-secret

# ──────────────────────────────────────────────────────────────────────────────
# Salesforce connector
# ──────────────────────────────────────────────────────────────────────────────
SALESFORCE_BASE_URL=https://your-org.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET_REF=salesforce-client-secret

# ──────────────────────────────────────────────────────────────────────────────
# Control Plane global settings
# ──────────────────────────────────────────────────────────────────────────────
# Runtime mode for the entire control plane: mock | live | hybrid
# Start with "mock" — no credentials required.
CONTROL_PLANE_MODE=mock

# Azure Key Vault URL for secret resolution in live/hybrid mode
# AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# ──────────────────────────────────────────────────────────────────────────────
# Generative KPI Challenge Agent (LLM)
# ──────────────────────────────────────────────────────────────────────────────
# Set to true to enable LLM-driven challenge questions and KPI formalization.
# When false (default) the agent falls back to deterministic templates.
# Requires FOUNDRY_PROJECT_ENDPOINT to be set above.
CONTROL_PLANE_KPI_LLM_ENABLED=false
CONTROL_PLANE_KPI_LLM_MODEL=gpt-4o-mini
