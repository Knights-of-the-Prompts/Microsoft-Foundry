# Microsoft Foundry project endpoint
# Found in: AI Foundry portal → your project → Overview → "Project endpoint"
PROJECT_ENDPOINT=

# Model deployment name in your AI Foundry project
AGENT_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure subscription and resource group
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=

# AI Foundry project name (used for cost attribution scoping)
AZURE_PROJECT_NAME=

# Name of the existing Azure AI Services / Cognitive Services resource
# (the resource that backs your AI Foundry hub — used for diagnostics & metrics)
AI_SERVICES_NAME=

# ──────────────────────────────────────────────────────────────────────────────
# Set by agent/main.py on first run — copy the printed value here
# AGENT_GUID=

# Set by governance/bootstrap_consent.py — run once as Global Admin
# GOVERNANCE_APP_CLIENT_ID=

# UPN or Entra object ID of the responsible owner and executive sponsor
# AGENT_OWNER=owner@contoso.com
# AGENT_SPONSOR=sponsor@contoso.com

# Business stream and environment — written to governance/agent_profile.yaml by set_ownership.py
# AGENT_BUSINESS_STREAM=IT Operations
# AGENT_ENVIRONMENT=development

# ──────────────────────────────────────────────────────────────────────────────
# Risk thresholds used by report/report.py
RISK_MAX_ERROR_RATE=0.05
RISK_COST_THRESHOLD_USD=10.00
RISK_IDLE_DAYS=3
