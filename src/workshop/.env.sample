# Microsoft Foundry Project Configuration
# Copy this file to .env and fill in your actual values
# You can use the setup_env.py or setup_env.sh script to automatically populate these values

# Required Configuration
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP_NAME=<your-resource-group-name>
AGENT_MODEL_DEPLOYMENT_NAME=gpt-4o # or your custom GPT-4o deployment name. Make sure to use GPT-4o when using Deep Research tool because GPT-4-turbo is not supported
AZURE_PROJECT_NAME=<your-project-name> # the name of your Microsoft Foundry project
PROJECT_ENDPOINT=https://<your-hub-name>.services.ai.azure.com/api/projects/<your-project-name> # the endpoint of your Microsoft Foundry project, you can find it in the Azure portal under Resource Management > Endpoints

# Optional Configuration for Advanced Features
# Uncomment and set when instructed in the labs/samples

# Deep Research Model (for samples that use o3 deep research)
# DEEP_RESEARCH_MODEL_DEPLOYMENT_NAME=o3-deep-research # or your custom Deep Research model deployment name

# Bing Grounding Connection (for samples that use web search)
# BING_RESOURCE_NAME=<your-bing-resource-name> # use the resource name as shown in Microsoft Foundry, not the Azure resource name

# Azure OpenAI Configuration (for Semantic Kernel samples)
# AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-resource-name>.openai.azure.com/
# AZURE_OPENAI_API_KEY_NAME=api-key # the name of the API key for your Azure OpenAI resource

# Notes:
# - AZURE_OPENAI_API_KEY is NOT required when using DefaultAzureCredential (recommended)
# - The workshop and samples use Azure CLI authentication (az login) for security
# - To automatically populate these values, run: python setup_env.py
