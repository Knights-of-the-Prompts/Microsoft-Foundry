# Microsoft Foundry Project Configuration Example
# Copy this file to .env and fill in your actual values
# You can use the setup_env.py or setup_env.sh script to automatically populate these values

# Required Configuration
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AGENT_MODEL_DEPLOYMENT_NAME=
AZURE_PROJECT_NAME=
PROJECT_ENDPOINT=

# Optional Configuration for Advanced Features
# Uncomment and set when instructed in the labs/samples

# ============================================================================
# WORKSHOP: Lab 1 — Function calling (Bing grounding)
# Name of the Bing grounding connection in your AI Foundry project.
# Found in: AI Foundry portal → your project → Management → Connections
# ============================================================================
# BING_CONNECTION_NAME=

# ============================================================================
# WORKSHOP: Advanced / debug settings
# ENVIRONMENT controls data source ("local" = bundled CSV, "acl" = ledger)
# AZURE_AI_PROJECT_ENDPOINT is an alias for PROJECT_ENDPOINT used by test scripts
# ============================================================================
# ENVIRONMENT=local
# AZURE_AI_PROJECT_ENDPOINT=

# ============================================================================
# AGENT 365 LAB (create-agent365-managed-agents sample)
# Run this block when working through the Agent 365 governance lab.
#
# AI_SERVICES_NAME   — name of the AI Services / Cognitive Services resource
#                      that backs your AI Foundry hub (Azure portal resource name)
# AGENT_GUID         — printed by agent/main.py on first run; copy it here
# AGENT_OWNER        — UPN or Entra object ID of the responsible owner
# AGENT_SPONSOR      — UPN or Entra object ID of the executive sponsor
# GOVERNANCE_APP_*   — set by governance/bootstrap_consent.py (run once as Global Admin)
# RISK_*             — thresholds used by report/report.py
# ============================================================================
# AI_SERVICES_NAME=
# AGENT_GUID=
# AGENT_OWNER=owner@contoso.com
# AGENT_SPONSOR=sponsor@contoso.com
# GOVERNANCE_APP_CLIENT_ID=
# GOVERNANCE_APP_CLIENT_SECRET=
# RISK_MAX_ERROR_RATE=0.05
# RISK_COST_THRESHOLD_USD=10.00
# RISK_IDLE_DAYS=3

# ============================================================================
# AGENT 365 LAB: Registration metadata (workshop main.py agent creation)
# Populate the Owner, Sponsor, Description, and Department fields on the agent.
# These are passed to create_version() as metadata.
# ============================================================================
# AGENT_DESCRIPTION=Contoso Sales Agent — answers questions about Contoso tent sales data using Microsoft Foundry
# AGENT_DEPARTMENT=Sales

# ============================================================================
# DEEP RESEARCH LAB (create-deep-research-tool sample)
# ============================================================================
# DEEP_RESEARCH_MODEL_DEPLOYMENT_NAME=
# BING_RESOURCE_NAME=

# ============================================================================
# SEMANTIC KERNEL SAMPLES (create-semantic-kernel-agents sample)
# ============================================================================
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY_NAME=

# Notes:
# - AZURE_OPENAI_API_KEY is NOT required when using DefaultAzureCredential (recommended)
# - The workshop and samples use Azure CLI authentication (az login) for security
# - To automatically populate these values, run: python setup_env.py

# ============================================================================
# OUTCOME-AWARE AGENTS LAB (create-outcome-aware-agents sample)
# Storage backend for the value ledger: "memory" (default) or "acl".
# ACL_ENDPOINT is required when LEDGER_BACKEND=acl (output of the Bicep deployment).
# LOCATION must be an ACL-supported region.
# ============================================================================
LEDGER_BACKEND=acl
# ACL_ENDPOINT=https://my-ledger.confidential-ledger.azure.com
# LOCATION=swedencentral
