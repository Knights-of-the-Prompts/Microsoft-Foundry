# Microsoft Foundry Project Configuration Example
# Copy this file to .env and fill in your actual values
# You can use the setup_env.py or setup_env.sh script to automatically populate these values

# Required Configuration
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AGENT_MODEL_DEPLOYMENT_NAME=
AZURE_PROJECT_NAME=
PROJECT_ENDPOINT=

# Optional Configuration for Advanced Features
# Uncomment and set when instructed in the labs/samples

# Deep Research Model (for samples that use o3 deep research)
# DEEP_RESEARCH_MODEL_DEPLOYMENT_NAME=

# Bing Grounding Connection (for samples that use web search)
# BING_RESOURCE_NAME=

# Azure OpenAI Configuration (for Semantic Kernel samples)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY_NAME=

# Notes:
# - AZURE_OPENAI_API_KEY is NOT required when using DefaultAzureCredential (recommended)
# - The workshop and samples use Azure CLI authentication (az login) for security
# - To automatically populate these values, run: python setup_env.py
# Storage backend for the value ledger: "memory" (default) or "acl".
LEDGER_BACKEND=acl

# Required when LEDGER_BACKEND=acl. Output of the Bicep deployment as `ledgerUri`.
# Example: https://my-ledger.confidential-ledger.azure.com
ACL_ENDPOINT=

# --- Azure deployment settings for the Outcome-Aware Agent lab ---
# Resource group reuses the workshop-wide AZURE_RESOURCE_GROUP_NAME above.
# ACL-supported region: swedencentral | eastus | westeurope | australiaeast | southeastasia
LOCATION=
